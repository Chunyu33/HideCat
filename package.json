{
  "name": "slacke-fish",
  "productName": "SlackeFish",
  "version": "1.4.1",
  "description": "SlackeFish",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite --config src/renderer/vite.config.js",
    "build:renderer": "vite build --config src/renderer/vite.config.js",
    "start": "cross-env NODE_ENV=development electron .",
    "start:prod": "cross-env NODE_ENV=production electron .",
    "make": "npm run build:renderer && electron-builder"
  },
  "build": {
    "appId": "com.liuchunyu.slackefish",
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/assets/**/*",
      "h5/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main/main.js"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "src/assets/app.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Chunyu33",
      "repo": "SlackeFish",
      "releaseType": "release"
    }
  },
  "keywords": [],
  "author": {
    "name": "liuchunyu",
    "email": "1378813463@qq.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.1.0",
    "css-loader": "^6.11.0",
    "dotenv-cli": "^11.0.0",
    "electron": "39.0.0",
    "electron-builder": "^26.0.12",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "antd": "^5.27.6",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.8"
  }
}
