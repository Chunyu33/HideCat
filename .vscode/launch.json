{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron + Vite",
      "type": "node",
      "request": "launch",

      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],

      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "protocol": "inspector",

      "preLaunchTask": "Start Vite"
    }
  ]
}
